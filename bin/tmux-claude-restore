#!/usr/bin/env bash
# Recreate windows/panes from a snapshot and resume each Claude session in place.
# usage: tmux-claude-restore [--auto] [snapshot.tsv]   (default: ~/.local/share/tmux-claude/last.tsv)
#   --auto: called from tmux.conf at server start; waits for the initial session to exist.
auto=; [ "$1" = --auto ] && { auto=1; shift; }
file=${1:-${TMUX_CLAUDE_DIR:-~/.local/share/tmux-claude}/last.tsv}
[ -f "$file" ] || { echo "no snapshot: $file" >&2; exit 1; }
if [ -n "$auto" ]; then
  for _ in $(seq 50); do tmux list-sessions >/dev/null 2>&1 && break; sleep 0.1; done
fi

# A session holding nothing but one fresh shell (what `tmux` gives you on startup) is a
# placeholder: move it out of the way so saved window numbers fit, and drop it afterwards.
placeholder() {
  tmux list-panes -s -t "=$1" -F '#{window_id} #{pane_current_command} #{@claude_sid}' 2>/dev/null |
    awk 'NR==1 && NF==2 && $2 ~ /^(zsh|bash|sh)$/ {id=$1} END {if (NR==1 && id) print id}'
}

declare -A target layout ph
active_panes=() active_window=
while IFS=$'\t' read -r sess win name lay pane path sid ccwd wact pact; do
  key="$sess:$win"
  [ -n "$ccwd" ] && path=$ccwd
  [ -d "$path" ] || path=$HOME
  if [ -z "${ph[$sess]+x}" ]; then
    ph[$sess]=$(placeholder "$sess")
    [ -n "${ph[$sess]}" ] && tmux move-window -s "${ph[$sess]}" -t "=$sess:9999" 2>/dev/null
  fi
  if [ -z "${target[$key]}" ]; then
    if ! tmux has-session -t "=$sess" 2>/dev/null; then
      t=$(tmux new-session -d -P -F '#{pane_id}' -s "$sess" -n "$name" -c "$path")
      tmux move-window -d -s "$t" -t "=$sess:$win" 2>/dev/null
    else
      t=$(tmux new-window -d -P -F '#{pane_id}' -t "=$sess:$win" -n "$name" -c "$path" 2>/dev/null ||
          tmux new-window -d -P -F '#{pane_id}' -t "=$sess:" -n "$name" -c "$path")
    fi
    target[$key]=$t; layout[$key]=$lay
  else
    t=$(tmux split-window -d -P -F '#{pane_id}' -t "${target[$key]}" -c "$path")
  fi
  [ "$pact" = 1 ] && active_panes+=("$t")
  [ "$wact" = 1 ] && [ "$pact" = 1 ] && [ -z "$active_window" ] && active_window=$t
  if [ -n "$sid" ]; then
    # Tag up front so saves fired by the first resumed Claude don't drop the others' IDs.
    tmux set-option -p -t "$t" @claude_sid "$sid"
    tmux set-option -p -t "$t" @claude_cwd "$ccwd"
    tmux send-keys -t "$t" "claude --resume $sid" Enter
  fi
done <"$file"
for key in "${!target[@]}"; do
  tmux select-layout -t "${target[$key]}" "${layout[$key]}" 2>/dev/null
done
for id in "${ph[@]}"; do
  [ -n "$id" ] && tmux kill-window -t "$id"
done
for t in "${active_panes[@]}"; do tmux select-pane -t "$t"; done
[ -n "$active_window" ] && tmux select-window -t "$active_window"
echo "restored ${#target[@]} windows"
